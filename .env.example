NODE_ENV=development
PORT=3000

# Database Connection (keep actual credentials secret in .env)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# JWT Authentication & Session Retention
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHMS=HS256
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7
JWT_REMEMBER_EXPIRES_IN=30d
JWT_REMEMBER_COOKIE_EXPIRES_IN=30

# Password Reset Token Salt (scrypt KDF key derivation salt)
TOKEN_HASH_SALT=replace_with_a_long_random_salt

# Email Service Configuration (Nodemailer SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM="Transit Tracker <no-reply@transittracker.com>"

# Admin Seed Configuration (npm run create-admin)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=

# Admin Registration Protection Key (Required for /api/v1/auth/admin/signup)
ADMIN_SECRET_KEY=replace_with_a_secure_admin_secret_key

# Location Logs Retention (TTL in days, 0 = no auto-expiry)
LOCATION_LOG_TTL_DAYS=0